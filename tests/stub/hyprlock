#!/usr/bin/env bash
# The locker, as far as the engine cares: something that stays alive and then does not.
# It never renders anything — the frames the engine publishes are the whole subject here
#
# It does record what it was started with, for the check that it reads its own config
if [[ -n "${STUB_HYPRLOCK_LOG:-}" ]]; then
  printf '%s\n' "$*" >"$STUB_HYPRLOCK_LOG"
fi
sleep "${STUB_HYPRLOCK_SLEEP:-20}"
